# =============================================================================
# Home Credit DataOps Pipeline — Environment Variables
# Copy file này thành .env và điền giá trị thực trước khi chạy.
# File .env đã được gitignore — KHÔNG commit giá trị production vào repo.
# =============================================================================

# ---------------------------------------------------------------------------
# Config paths (tùy chọn — có default trong config.py nếu không đặt)
# ---------------------------------------------------------------------------

# Path tới homecredit_config.yaml
# Mặc định: <project_root>/cli/flows/config/homecredit_config.yaml
# CONFIG_PATH=cli/flows/config/homecredit_config.yaml

# Path tới stack.yaml (MinIO, Spark)
# Mặc định: <project_root>/platforms/config/stack.yaml
# STACK_CONFIG_PATH=platforms/config/stack.yaml

# Path tới logger_config.yaml
# Mặc định: <project_root>/log/config/logger_config.yaml
# LOGGER_CONFIG_PATH=log/config/logger_config.yaml

# Thư mục chứa source CSV (Bronze ingestion input)
# Mặc định: <project_root>/cli/ingestion/source_data
# SOURCE_DIR=cli/ingestion/source_data

# Path tới Design modeling_doc.csv
# Mặc định: <project_root>/cli/ingestion/design_modelling/Design modeling_doc.csv
# DESIGN_METADATA_PATH=cli/ingestion/design_modelling/Design modeling_doc.csv

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------

# development | staging | production
HOME_CREDIT_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=homecredit_mart
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# ---------------------------------------------------------------------------
# MinIO / S3
# ---------------------------------------------------------------------------

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=homecredit

# ---------------------------------------------------------------------------
# Prefect
# ---------------------------------------------------------------------------

# URL của Prefect API server (dùng khi không chạy ephemeral)
PREFECT_API_URL=http://localhost:4200/api
